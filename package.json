{
  "name": "qix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faithful browser recreation of Qix (Taito America, 1981) in modern TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome ci . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "zzfx": "^1.3.2"
  }
}
